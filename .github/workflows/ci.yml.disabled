# PARKED until the final PR at the project owner's request.
# GitHub only runs .yml/.yaml workflow files, so the .disabled suffix prevents
# this workflow from running. To re-enable it, rename the file back to ci.yml.
name: CI

on:
  push:
  pull_request:

env:
  CARGO_TERM_COLOR: always

jobs:
  checks:
    name: Format, lint and test (Linux)
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: "1.96.0"
          components: rustfmt, clippy

      - name: Cache Cargo build
        uses: Swatinem/rust-cache@v2

      - name: Install Linux window-system build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends libwayland-dev libxkbcommon-dev

      - name: Check formatting
        run: cargo fmt --all -- --check

      - name: Compile all targets
        run: cargo check --workspace --all-targets

      - name: Run Clippy
        run: cargo clippy --workspace --all-targets -- -D warnings

      - name: Run tests
        run: cargo test --workspace --all-targets

      - name: Check dependency boundaries
        run: |
          set -euo pipefail
          if cargo tree -p stars-core --edges normal --prefix none | tail -n +2 | grep -q .; then
            echo "stars-core must not have any dependencies"
            cargo tree -p stars-core --edges normal
            exit 1
          fi
          for package in stars-core stars-ai stars-tools; do
            if cargo tree -p "$package" --edges normal | grep -qE 'stars-desktop|eframe|egui'; then
              echo "$package must not depend on the desktop or UI packages"
              cargo tree -p "$package" --edges normal
              exit 1
            fi
          done
          if cargo tree -p stars-ai --edges normal | grep -q 'stars-desktop'; then
            echo "stars-ai must not depend on stars-desktop"
            exit 1
          fi

  build:
    name: Build (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-24.04, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: "1.96.0"

      - name: Cache Cargo build
        uses: Swatinem/rust-cache@v2

      - name: Install Linux window-system build dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends libwayland-dev libxkbcommon-dev

      - name: Build workspace
        run: cargo build --workspace --all-targets

      - name: Run headless shell tests
        run: cargo test -p stars-desktop --test shell
